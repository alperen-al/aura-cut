{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA CUT",
  "version": "1.0.0",
  "identifier": "com.alp.auracut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AURA CUT",
        "width": 1340,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#090A0F",
        "windowEffects": {
          "effects": ["mica"]
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org; font-src 'self'; connect-src ipc: http://ipc.localhost https://tr.wikipedia.org https://en.wikipedia.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Definasyon & Beslenme Takibi",
    "category": "HealthcareAndFitness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"]
      }
    }
  }
}
